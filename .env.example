# Environment configuration for the Rental Management System.
# Copy to `.env` and load these into your web server, OR set them directly in
# your server/vhost config. config/app.php reads them via getenv().
#
# NOTE: PHP does not read .env automatically. Either:
#   - set these as real environment variables (Apache SetEnv / php-fpm env), or
#   - edit the defaults in config/app.php for local development.

# --- Application ---
APP_NAME="Rental Management System"
APP_ENV=development
APP_TIMEZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES

# --- Email (SMTP) ---
# These are defaults only. Admin -> Email stores overrides in the database and
# takes precedence; configure and test mail there when the app is running.
# Set APP_URL to the externally reachable app root (include /rental_system if applicable).
APP_URL=https://yourdomain.com/rental_system
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# tls for STARTTLS/587, ssl for implicit TLS/465, or none if your server requires no encryption.
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Rental Management System"

# --- PDF receipts ---
# WeasyPrint is preferred; Edge/Chrome can render PDFs automatically on Windows.
WEASYPRINT_BINARY=weasyprint
# Optional full path/name for Chromium, Edge, or Chrome when not auto-detected.
PDF_BROWSER_BINARY=

# --- Database (XAMPP defaults shown) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rentals
DB_USER=root
DB_PASS=

# --- Cron (monthly invoice generator) ---
# CLI (Task Scheduler / cron) never needs this. If the generator is triggered
# over HTTP, send this secret as ?token=... or the X-Cron-Token header. When
# unset, all HTTP requests to cron/generate_monthly.php are refused.
CRON_TOKEN=

# --- Pesapal API 3.0 ---
# PESAPAL_MODE: simulate | sandbox | live
#   simulate -> local mock checkout, no external calls (default, for development)
#   sandbox  -> https://cybqa.pesapal.com/pesapalv3 (test credentials)
#   live     -> https://pay.pesapal.com/v3 (production credentials)
PESAPAL_MODE=simulate
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

# Publicly reachable endpoints (REQUIRED for sandbox/live so Pesapal can call back).
# Leave blank in simulate mode; they are auto-derived from the current host.
PESAPAL_IPN_URL=https://yourdomain.com/rental_system/payment/callback.php
PESAPAL_REDIRECT_URL=https://yourdomain.com/rental_system/tenant/payment_status.php
